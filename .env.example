LLM_PROVIDER=auto
LLM_MAX_ATTEMPTS=2
LLM_REQUEST_TIMEOUT=10
LLM_CIRCUIT_FAILURE_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_SECONDS=30

# Gemini（默认优先使用）
GEMINI_API_KEY=your_gemini_key_here
# 可选：逗号分隔的 Gemini Key 池；仅当 Key 属于不同配额项目时才有意义。
# GEMINI_API_KEYS=key_one,key_two,key_three

# 可选备用 Provider：Gemini 限流或暂时不可用时自动切换。
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI 官方 API
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_key_here
# LLM_MODEL=gpt-4.1-mini

# 任意 OpenAI-compatible API，例如 DeepSeek、Qwen、SiliconFlow 或 vLLM。
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your_provider_key_here
# LLM_MODEL=your_model_name
# LLM_BASE_URL=https://provider.example.com/v1

# DeepSeek Flash（官方 Beta 严格工具端点；密钥只保存在本地 .env）。
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your_deepseek_key_here
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com/beta
# OPENAI_COMPATIBLE_STRICT_TOOLS=true
# LLM_REQUEST_TIMEOUT=45
# 仅用于支持 thinking 参数的兼容服务；不设置时保持服务默认值。
# OPENAI_COMPATIBLE_THINKING_MODE=disabled
# 可选：目标理解与独立审查使用低强度思考，其余逐步决策保持快速模式。
# OPENAI_COMPATIBLE_GOAL_THINKING_MODE=enabled
# OPENAI_COMPATIBLE_GOAL_REASONING_EFFORT=low
# OPENAI_COMPATIBLE_FINAL_RESPONSE_THINKING_MODE=disabled

# 可选：按顺序声明备用 Provider。备用项读取各自的专用变量。
# LLM_FALLBACK_PROVIDERS=groq,gemini

# 可选：按运行用途覆盖主 Provider 的模型名。
# LLM_ROUTER_MODEL=your_fast_router_model
# LLM_GOAL_MODEL=your_goal_understanding_model
# LLM_PLANNER_MODEL=your_planner_model
# LLM_AGENT_MODEL=your_tool_calling_model
# LLM_FINAL_RESPONSE_MODEL=your_response_model
