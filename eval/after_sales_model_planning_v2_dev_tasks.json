      "category": "after_sales_multi_turn",
      "language": "zh",
      "description": "按用户关注顺序选择材料问题，并在真实补充后重新规划。",
      "fixture": {
        "after_sales": {
          "reason_code": "NOT_AS_DESCRIBED",
          "delivered_days_ago": 2,
          "required_evidence": [
            {
              "evidence_type": "ORIGINAL_PACKAGING",
              "accepted_sources": [
                "CUSTOMER_STATEMENT"
              ],
              "condition": "CUSTOMER_ATTESTATION",
              "description": "核对原包装完整与附件齐全两个方面"
            },
            {
              "evidence_type": "SERIAL_LABEL",
              "accepted_sources": [
                "CUSTOMER_STATEMENT"
              ],
              "condition": "CUSTOMER_ATTESTATION",
              "description": "核对序列号标签是否清晰完整"
            }
          ]
        }
      },
      "turns": [
        {
          "message": "订单 1001 的耳机出现异响，与商品描述不符，请建立售后案件处理。原包装、附件和序列号标签的状态我目前都还没核对。请先和我核对原包装及附件的情况，再核对序列号标签。",
          "expect": {
            "statuses": [
              "SUCCEEDED",
              "PARTIAL"
            ],
            "tools": [
              {
                "name": "prepare_after_sales_case"
              }
            ],
            "forbidden_tools": [
              "submit_after_sales_case",
              "initiate_refund",
              "process_payment"
            ],
            "db": {
              "refunds.1001.status": "none"
            },
            "error_present": false,
            "pending_present": false
          },
          "expected_next_requirement": "ORIGINAL_PACKAGING"
        },
        {
          "message": "补充订单 1001 的售后材料：我已核对序列号标签，标签清晰完整。",
          "expect": {
            "statuses": [
              "SUCCEEDED",
              "PARTIAL"
            ],
            "tools": [
              {
                "name": "continue_after_sales_case"
              }
            ],
            "forbidden_tools": [
              "submit_after_sales_case",
              "initiate_refund",
              "process_payment"
            ],
            "db": {
              "refunds.1001.status": "none"
            },
            "error_present": false,
            "pending_present": false
          },
          "expected_material_types": [
            "SERIAL_LABEL"
          ]
        },
        {
          "message": "继续补充该案件的原包装材料：原包装完整，附件全部齐全。",
          "expect": {
            "statuses": [
              "WAITING_APPROVAL"
            ],
            "tools": [
              {
                "name": "continue_after_sales_case"
              }
            ],
            "forbidden_tools": [
              "submit_after_sales_case",
              "initiate_refund",
              "process_payment"
            ],
            "db": {
              "refunds.1001.status": "none"
            },
            "terminal_reason": "APPROVAL_REQUIRED",
            "pending_action": {
              "type": "SUBMIT_AFTER_SALES_CASE",
              "requires_approval": true
            }
          },
          "expected_material_types": [
            "ORIGINAL_PACKAGING"
          ]
        }
      ]
