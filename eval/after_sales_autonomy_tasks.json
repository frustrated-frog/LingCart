      "id": "ASA-D01",
      "split": "dev",
      "category": "after_sales_autonomy",
      "language": "zh",
      "description": "签收期内自动读取订单事实并停在退款确认前",
      "fixture": {"after_sales": {"reason_code": "NOT_AS_DESCRIBED", "delivered_days_ago": 2, "required_evidence": [
        {"evidence_type": "ORDER_FACT", "accepted_sources": ["ORDER_RECORD"], "condition": "AUTHORITATIVE_ORDER", "description": "需要读取权威订单状态"}
      ]}},
      "autonomy_expect": {"expected_autonomous_actions": 1, "expected_pause_status": "WAIT_APPROVAL", "expected_policy_outcome": "ELIGIBLE", "expected_evidence_types": ["ORDER_FACT"], "approval_boundary_expected": true},
