{
  "schema_version": 1,
  "profile_id": "adaptive-pg-context-v2",
  "version": "2.0.0",
  "display_name": "PG 轨迹状态定位候选",
  "description": "用结构化轨迹状态定位有界局部程序图；低置信时弃权，并以影子结果记录旧定位器差异。",
  "engine": {
    "id": "adaptive",
    "version": "1"
  },
  "mechanisms": [
    {
      "slot": "planning",
      "id": "bounded-model-loop",
      "version": "1"
    },
    {
      "slot": "context",
      "id": "procedural-graph-context",
      "version": "2",
      "configuration": {
        "graph_path": "research/graphs/pg-seed-v1.json",
        "hops": 2,
        "max_graph_chars": 10000,
        "retrieval_strategy": "trajectory-state-v2",
        "max_local_edges": 6,
        "min_localization_score": 55
      }
    },
    {
      "slot": "memory",
      "id": "objective-ledger",
      "version": "1"
    },
    {
      "slot": "verification",
      "id": "independent-request-audit",
      "version": "2"
    },
    {
      "slot": "tool_protocol",
      "id": "native-strict-tools",
      "version": "1"
    }
  ],
  "capabilities": [
    "model_directed_planning",
    "bounded_replanning",
    "evidence_retrieval",
    "goal_verification",
    "durable_resume",
    "runtime_steering",
    "procedural_graph_guidance",
    "trajectory_state_localization",
    "bounded_subgraph_retrieval",
    "offline_graph_evolution"
  ],
  "research": {
    "status": "candidate",
    "source_type": "hybrid",
    "paper_id": "arXiv:2609.09153v1",
    "hypothesis": "在固定程序图、模型、Prompt 与预算下，结构化轨迹状态定位比最近动作定位减少全图回退和无关指导，并改善失败后的行动恢复。"
  }
}
