  "capabilities": [
    "model_directed_planning",
    "bounded_replanning",
    "ace_frozen_playbook",
    "offline_experience_learning",
    "goal_verification",
    "durable_resume",
    "runtime_steering"
  ],
  "research": {
    "status": "candidate",
    "source_type": "hybrid",
    "paper_id": "arXiv:2510.04618v3",
    "hypothesis": "由 dev 真实轨迹经过 Generator、Reflector、Curator 增量学习的冻结 Playbook，可在不放宽硬约束和不增加安全违规的前提下，提高复杂消费任务的跨任务成功率与恢复稳定性。"
  }
