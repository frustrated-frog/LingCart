      "id": "set_goal",
      "kind": "ACTION",
      "description": "明确目标与约束"
    },
    {
      "id": "search_products",
      "kind": "ACTION",
      "description": "检索候选商品"
    },
    {
      "id": "inspect",
      "kind": "ACTION",
      "description": "读取完整证据"
    },
    {
      "id": "recommend",
      "kind": "ACTION",
      "description": "选择符合约束的候选"
    },
    {
      "id": "complete",
      "kind": "ACTION",
      "description": "提交逐项完成证据"
    },
    {
      "id": "clarify",
      "kind": "ACTION",
      "description": "请求缺失信息"
    },
    {
