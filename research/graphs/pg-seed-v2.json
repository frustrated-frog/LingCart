      "kind": "STATE",
      "description": "结束本次执行"
    }
  ],
  "edges": [
    {
      "id": "start-goal",
      "source": "Start",
      "target": "set_goal",
      "relation": "LEADS_TO",
      "condition": "尚未明确目标",
      "guidance": "先明确用户目标与约束",
      "pitfalls": "不要猜测关键参数",
      "applicability": {
        "all_of": [
          {"fact": "goal.defined", "operator": "EQ", "value": false}
        ],
        "any_of": []
      }
    },
    {
      "id": "goal-search",
      "source": "set_goal",
      "target": "search_products",
      "relation": "LEADS_TO",
      "condition": "存在尚未完成的商品推荐目标",
      "guidance": "按目标检索候选",
      "pitfalls": "局部检索结果不是全目录",
      "applicability": {
        "all_of": [
          {"fact": "goal.unresolved_kinds", "operator": "CONTAINS", "value": "recommend"}
        ],
        "any_of": []
      }
    },
    {
      "id": "search-inspect",
      "source": "search_products",
      "target": "inspect",
      "relation": "LEADS_TO",
      "condition": "最近一次商品检索返回非空候选证据",
      "guidance": "读取完整证据后再选择",
      "pitfalls": "索引不能替代原始记录",
      "applicability": {
        "all_of": [
          {"fact": "trajectory.latest_action", "operator": "EQ", "value": "search_products"},
          {"fact": "trajectory.latest_outcome", "operator": "EQ", "value": "NON_EMPTY"}
        ],
        "any_of": []
      }
    },
    {
      "id": "inspect-recommend",
      "source": "inspect",
      "target": "recommend",
      "relation": "LEADS_TO",
      "condition": "最近一次完整证据读取成功",
      "guidance": "结合目标约束选择候选",
      "pitfalls": "不能仅依据经验认定合格",
      "applicability": {
        "all_of": [
          {"fact": "trajectory.latest_action", "operator": "EQ", "value": "inspect"},
          {"fact": "trajectory.latest_outcome", "operator": "EQ", "value": "SUCCESS"}
        ],
        "any_of": []
      }
    },
    {
      "id": "recommend-complete",
      "source": "recommend",
      "target": "complete",
      "relation": "LEADS_TO",
      "condition": "全部目标已有经过核验的完成证据",
      "guidance": "提交目标完成证据",
      "pitfalls": "不要遗漏复合目标",
      "applicability": {
        "all_of": [
          {"fact": "goal.all_verified", "operator": "EQ", "value": true}
        ],
        "any_of": []
      }
    },
    {
      "id": "complete-end",
      "source": "complete",
      "target": "End",
      "relation": "LEADS_TO",
      "condition": "全部目标已核验完成",
      "guidance": "结束当前任务",
      "pitfalls": "审查未通过则继续补证",
      "applicability": {
        "all_of": [
          {"fact": "goal.all_verified", "operator": "EQ", "value": true}
        ],
        "any_of": []
      }
    },
    {
      "id": "goal-clarify",
      "source": "set_goal",
      "target": "clarify",
      "relation": "LEADS_TO",
      "condition": "Runtime 已记录无法继续执行的结构化反馈",
      "guidance": "询问最小缺失信息",
      "pitfalls": "不要猜测用户授权",
      "applicability": {
        "all_of": [
          {"fact": "runtime.feedback_code", "operator": "EXISTS", "value": null}
        ],
        "any_of": []
      }
    },
    {
      "id": "clarify-end",
      "source": "clarify",
      "target": "End",
      "relation": "LEADS_TO",
      "condition": "已经提交澄清问题并等待用户",
      "guidance": "等待用户补充",
      "pitfalls": "不要自行代答",
      "applicability": {
        "all_of": [
          {"fact": "trajectory.latest_action", "operator": "EQ", "value": "clarify"}
        ],
        "any_of": []
      }
    }
  ]
}
